# Alpaca Trading API — https://alpaca.markets
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true   # true = تجريبي | false = حقيقي

# Musaffa API Key — احصل عليه من: https://musaffa.com/developers
MUSAFFA_API_KEY=your_musaffa_key_here

# Zoya Finance API Key (اختياري) — https://zoya.finance
ZOYA_API_KEY=your_zoya_key_here

# Railway يضبط PORT تلقائياً — لا تغيّره
PORT=8000
