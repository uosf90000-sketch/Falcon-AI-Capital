# ── متغيرات بيئة n8n على Railway ──────────────────────────────────────────────

# بيانات الدخول لـ n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=ضع_كلمة_سر_قوية_هنا

# عنوان Railway الخاص بك (بعد النشر)
N8N_HOST=your-app.railway.app
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-app.railway.app

# Timezone السعودية
GENERIC_TIMEZONE=Asia/Riyadh

# ── مفاتيح API ─────────────────────────────────────────────────────────────────

# مفتاح Musaffa — من: https://musaffa.com/developers
MUSAFFA_API_KEY=musaffa_key_هنا

# Webhook للإشعارات (Telegram/Slack/Discord — اختياري)
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/...
